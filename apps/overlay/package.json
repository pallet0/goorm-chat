{
  "name": "guruem-chat-overlay",
  "version": "0.1.0",
  "description": "Transparent always-on-top chat overlay for 구름 club presentations.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test renderer/*.test.mjs",
    "build:icon": "node scripts/build-icon.js",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "club.guruem.chat-overlay",
    "productName": "GuruemChatOverlay",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.34.5"
  }
}
